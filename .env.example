# Live model for single reviews and quick results. Set ONE provider.
# LLM_PROVIDER=google  -> needs GOOGLE_GENERATIVE_AI_API_KEY
# LLM_PROVIDER=xai     -> needs XAI_API_KEY
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Adaption batch analysis (Settings > API keys in the Adaption app)
ADAPTION_API_KEY=
